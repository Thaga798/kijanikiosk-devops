# Stage 1: Builder
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package manifests first for better layer caching
COPY package.json package-lock.json ./

# Install all dependencies
RUN npm ci

# Copy application source and build
COPY . .
RUN npm run build

# Stage 2: Production
FROM node:18-alpine AS production

WORKDIR /app

# Create non-root group and user
RUN addgroup -S kijani && adduser -S kijani -G kijani

# Copy package manifests from builder
COPY --from=builder /app/package.json /app/package-lock.json ./

# Install production dependencies only
RUN npm ci --omit=dev

# Copy compiled application only
COPY --from=builder /app/dist ./dist

# Give the application user ownership
RUN chown -R kijani:kijani /app

# Run as non-root user
USER kijani

# Check application health
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3001/health || exit 1

EXPOSE 3001

# Run Node directly
CMD ["node", "dist/index.js"]
