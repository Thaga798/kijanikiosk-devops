# Stage 1: Prepare application files
FROM alpine:3.20 AS build

WORKDIR /build
COPY server.js package.json ./

# Stage 2: Minimal production runtime
FROM alpine:3.20 AS production

RUN apk add --no-cache nodejs ca-certificates \
    && addgroup -S -g 10001 kijani \
    && adduser -S -u 10001 -G kijani kijani

WORKDIR /app

COPY --from=build --chown=kijani:kijani /build/server.js ./server.js
COPY --from=build --chown=kijani:kijani /build/package.json ./package.json

ARG APP_VERSION=1.0.0-local
ENV NODE_ENV=production
ENV PORT=3001
ENV APP_VERSION=${APP_VERSION}

USER kijani

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3001/health || exit 1

CMD ["node", "server.js"]
